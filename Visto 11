CREATE VIEW vw_SEMDEVOLUCAO AS
SELECT l.Titulo
FROM Livros l
JOIN Emprestimos e ON l.ID_livros = e.livro_id
WHERE e.Data_devolucao IS NULL
SELECT * FROM vw_SEMDEVOLUCAO
--b)
CREATE VIEW vw_HISTORICOS AS
SELECT A.Nome_aluno, L.Titulo, E.Data_emprestimo, E.Data_devolucao
FROM Alunos A
JOIN Emprestimos E ON A.ID_alunos = E.aluno_id
LEFT JOIN Livros L ON E.livro_id = L.ID_livros

SELECT * FROM vw_HISTORICOS
--c)
CREATE VIEW vw_SEMEMPRESTIMO AS
SELECT l.Titulo
FROM Livros l
JOIN Emprestimos e ON l.ID_livros = e.livro_id
WHERE e.Data_emprestimo IS NULL
