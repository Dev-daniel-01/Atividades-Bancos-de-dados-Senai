CREATE DATABASE Banco_Financeiro
GO
USE Banco_Financeiro
GO
CREATE TABLE Cliente (
ID_cliente INT IDENTITY(1,1) PRIMARY KEY,
Nome_cliente NVARCHAR(100) NOT NULL,
CPF CHAR(14) UNIQUE NOT NULL
);
CREATE TABLE Conta (
ID_conta INT IDENTITY(1,1) PRIMARY KEY,
Numero_conta VARCHAR(20) UNIQUE NOT NULL,
Saldo DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
cliente_id INT,
FOREIGN KEY (cliente_id) REFERENCES Cliente(ID_cliente) ON DELETE
CASCADE
);
CREATE TABLE Transacao (
ID_transacao INT IDENTITY(1,1) PRIMARY KEY,
Tipo_transacao VARCHAR(20),
Valor_transacao DECIMAL(10, 2) NOT NULL,
Data_ransacao DATETIME NOT NULL DEFAULT GETDATE(),
conta_id INT,
FOREIGN KEY (conta_id) REFERENCES Conta(Id_conta)
);
