ID_dinossauro INT PRIMARY KEY,
Nome_dino VARCHAR(50) NOT NULL,
Especie_dino VARCHAR(50) NOT NULL,
Idade_dino INT NOT NULL,
Cercados INT NOT NULL
);

CREATE TABLE Movimentacao (
ID_movimentacao INT PRIMARY KEY,
Dinossauro_id INT NOT NULL,
cercado_origem_id INT NOT NULL,
Cercado_Destino_id INT NOT NULL,
Data_Movimentacao DATE NOT NULL,
FOREIGN KEY (Dinossauro_id) REFERENCES Dinossauro(ID_dinossauro),
FOREIGN KEY (cercado_origem_id) REFERENCES Cercado(ID_cercado),
FOREIGN KEY (Cercado_Destino_id) REFERENCES Cercado(ID_cercado)
);
