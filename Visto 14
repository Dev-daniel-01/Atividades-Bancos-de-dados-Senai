CREATE PROCEDURE ObterDetalhesConsulta
@ConsultaID INT
AS
BEGIN
SELECT
p.Nome_pacientes AS Nomep,

m.Nome_medicos AS Nomem,
c.ID_consultas,
(
SELECT dbo.CalcularPrecoTotal(@ConsultaID)
)AS PrecoTotal
FROM Pacientes p
JOIN Consultas c ON p.ID_pacientes = c.Paciente_id
JOIN Medicos m ON m.Pacienteid = p.ID_pacientes
WHERE p.ID_pacientes = @ConsultaID

END
