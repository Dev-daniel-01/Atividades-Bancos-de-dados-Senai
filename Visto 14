CREATE FUNCTION CalcularPrecoTotal (@Idpedido INT)
RETURNS DECIMAL(10, 2)
AS
BEGIN
DECLARE @PrecoTotal DECIMAL(10, 2)
SELECT @PrecoTotal = SUM(c.Preco)
FROM Pacientes P
JOIN Consultas c ON P.ID_pacientes = c.Paciente_id
WHERE P.ID_pacientes = @Idpedido
RETURN @PrecoTotal;
END;
