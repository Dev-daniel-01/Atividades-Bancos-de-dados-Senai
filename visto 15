USE F1;
GO

CREATE TABLE Equipes (
    ID_equipe INT PRIMARY KEY,
    Nome_equipe VARCHAR(255),
    Nacionalidade VARCHAR(255)
);

CREATE TABLE Pilotos (
    ID_piloto INT PRIMARY KEY,
    Nome_piloto VARCHAR(255),
    ID_equipe INT,
    FOREIGN KEY (ID_equipe) REFERENCES Equipes(ID_equipe)
);

CREATE TABLE Corridas (
    ID_Corrida INT PRIMARY KEY,
    NomeCorrida VARCHAR(255) NOT NULL,
    DataCorrida DATE
);

CREATE TABLE Resultados (
    piloto_id INT,
    corrida_id INT,
    FOREIGN KEY (piloto_id) REFERENCES Pilotos(ID_piloto),
    FOREIGN KEY (corrida_id) REFERENCES Corridas(ID_Corrida),
    PRIMARY KEY (piloto_id, corrida_id)
);

