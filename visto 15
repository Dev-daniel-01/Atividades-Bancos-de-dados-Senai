-- a) Consultas relacionadas a vitórias por ano
WITH VitoriasPorAno AS (
    SELECT
        p.Nome_piloto,
        YEAR(c.DataCorrida) AS Ano,
        COUNT(*) AS Vitorias
    FROM
        Resultados r
    JOIN
        Pilotos p ON r.piloto_id = p.ID_piloto
    JOIN
        Corridas c ON r.corrida_id = c.ID_Corrida
    WHERE
        r.piloto_id IN (SELECT piloto_id FROM Resultados WHERE corrida_id = c.ID_Corrida)
    GROUP BY
        p.Nome_piloto, YEAR(c.DataCorrida)
)
SELECT *
FROM VitoriasPorAno
PIVOT (
    SUM(Vitorias)
    FOR Ano IN ([2020], [2021], [2022], [2023])  
) AS P
ORDER BY Nome_piloto;

-- b) Consultas relacionadas à média de posições
WITH PosicoesMedia AS (
    SELECT
        p.Nome_piloto,
        AVG(r.corrida_id) AS Media_Positiva -- Alterado para utilizar corrida_id como exemplo
    FROM
        Resultados r
    JOIN
        Pilotos p ON r.piloto_id = p.ID_piloto
    GROUP BY
        p.Nome_piloto
)
SELECT *
FROM PosicoesMedia
ORDER BY Media_Positiva;

-- c) Consultas relacionadas à classificação por pontos
WITH PontosPorPiloto AS (
    SELECT
        p.Nome_piloto,
        COUNT(r.corrida_id) AS Total_Corridas -- Exemplo de contagem de corridas
    FROM
        Resultados r
    JOIN
        Pilotos p ON r.piloto_id = p.ID_piloto
    GROUP BY
        p.Nome_piloto
),
Classificacao AS (
    SELECT
        Nome_piloto,
        Total_Corridas,
        RANK() OVER (ORDER BY Total_Corridas DESC) AS Classificacao
    FROM
        PontosPorPiloto
)
SELECT *
FROM Classificacao
ORDER BY Classificacao;




